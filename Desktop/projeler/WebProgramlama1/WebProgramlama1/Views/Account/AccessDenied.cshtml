@{
    ViewData["Title"] = "Erişim Engellendi";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            
            <div class="display-1 text-danger mb-4">
                <i class="bi bi-exclamation-triangle-fill"></i> <span>⛔</span> </div>

            <h1 class="display-5 fw-bold text-danger">Erişim Engellendi</h1>
            <p class="lead text-muted mt-3">
                Bu sayfayı görüntülemek için yeterli yetkiniz bulunmamaktadır.
            </p>
            
            <hr class="my-4">
            
            <p>
                Eğer bir hata olduğunu düşünüyorsanız sistem yöneticisi ile iletişime geçiniz.
            </p>

            <div class="d-grid gap-2 d-sm-flex justify-content-sm-center mt-4">
                <a asp-controller="Home" asp-action="Index" class="btn btn-secondary btn-lg px-4 gap-3">Anasayfaya Dön</a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-danger btn-lg px-4">Farklı Hesapla Giriş</a>
            </div>

        </div>
    </div>
</div>